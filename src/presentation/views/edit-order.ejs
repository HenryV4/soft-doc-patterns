<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Редагування замовлення</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-5">
    <div class="card shadow p-4">
        <h2>Редагування замовлення #<%= order.orderId %></h2>
        <hr>
        <form action="/orders/edit/<%= order.orderId %>" method="POST">
            <div class="mb-3">
                <label class="form-label">Статус</label>
                <select name="status" class="form-select">
                    <option value="PENDING" <%= order.status === 'PENDING' ? 'selected' : '' %>>Очікує (Pending)</option>
                    <option value="ACCEPTED" <%= order.status === 'ACCEPTED' ? 'selected' : '' %>>Прийнято (Accepted)</option>
                    <option value="COMPLETED" <%= order.status === 'COMPLETED' ? 'selected' : '' %>>Завершено (Completed)</option>
                    <option value="CANCELLED" <%= order.status === 'CANCELLED' ? 'selected' : '' %>>Скасовано (Cancelled)</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Загальна вартість (грн)</label>
                <input type="number" step="0.01" name="totalPrice" class="form-control" value="<%= order.totalPrice %>" required>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Зберегти зміни</button>
                <a href="/" class="btn btn-secondary">Назад до списку</a>
            </div>
        </form>
    </div>
</body>
</html>