<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Нове замовлення</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-5">
    <div class="card shadow p-4">
        <h2>Створити нове замовлення</h2>
        <form action="/orders/create" method="POST">
            <div class="mb-3">
                <label class="form-label">Статус</label>
                <input type="text" name="status" class="form-control" value="PENDING" readonly>
            </div>
            <div class="mb-3">
                <label class="form-label">Початкова ціна (грн)</label>
                <input type="number" step="0.01" name="totalPrice" class="form-control" placeholder="Наприклад: 150.00" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Клієнт</label>
                <select name="customerId" class="form-select" required>
                    <option value="">Оберіть клієнта...</option>
                    <% customers.forEach(c => { %>
                        <option value="<%= c.userId %>"><%= c.firstName %> <%= c.lastName %></option>
                    <% }) %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Водій</label>
                <select name="driverId" class="form-select" required>
                    <option value="">Оберіть водія...</option>
                    <% drivers.forEach(d => { %>
                        <option value="<%= d.userId %>"><%= d.firstName %> <%= d.lastName %></option>
                    <% }) %>
                </select>
            </div>
            <button type="submit" class="btn btn-success">Створити</button>
            <a href="/" class="btn btn-secondary">Скасувати</a>
        </form>
    </div>
</body>
</html>