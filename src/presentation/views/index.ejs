<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <title>Taxi Service - Список замовлень</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Список замовлень</h1>
        <a href="/orders/create" class="btn btn-success">Створити замовлення</a>
    </div>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Клієнт</th>
                <th>Водій</th>
                <th>Ціна</th>
                <th>Статус</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            <% orders.forEach(order => { %>
                <tr>
                    <td><%= order.orderId %></td>
                    <td><%= order.customer ? order.customer.firstName + ' ' + order.customer.lastName : '—' %></td>
                    <td><%= order.driver ? order.driver.firstName + ' ' + order.driver.lastName : '—' %></td>
                    <td><%= order.totalPrice %> грн</td>
                    <td>
                        <span class="badge <%= order.status === 'COMPLETED' ? 'bg-success' : 'bg-warning' %>">
                            <%= order.status %>
                        </span>
                    </td>
                    <td>
                        <a href="/orders/edit/<%= order.orderId %>" class="btn btn-warning btn-sm">Редагувати</a>
                        <form action="/orders/delete/<%= order.orderId %>" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Видалити замовлення #<%= order.orderId %>?')">Видалити</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>